{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":separateMajorReleases"],
  "packageRules": [
    {
      "description": "Group pinned GitHub Actions updates weekly",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["before 9am on sunday"],
      "pinDigests": true
    },
    {
      "description": "Review Home Assistant and its test harness together",
      "matchPackageNames": ["homeassistant", "pytest-homeassistant-custom-component"],
      "groupName": "home-assistant-tests"
    }
  ]
}
